generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(uuid())
  name         String
  email        String       @unique
  passwordHash String       @map("password_hash")
  role         String       @default("ADMIN")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  invitations  Invitation[]

  @@map("users")
}

model Invitation {
  id              String    @id @default(uuid())
  slug            String    @unique
  title           String
  status          String    @default("DRAFT")
  templateId      String    @default("royal-gold") @map("template_id")
  primaryColor    String    @default("#B8972E") @map("primary_color")
  secondaryColor  String    @default("#58111A") @map("secondary_color")
  accentColor     String    @default("#D4AF37") @map("accent_color")
  backgroundColor String    @default("#FAF7F2") @map("background_color")
  textColor       String    @default("#1F2937") @map("text_color")
  fontFamily      String    @default("Cinzel") @map("font_family")
  headingFont     String    @default("Cinzel") @map("heading_font")
  musicEnabled    Boolean   @default(true) @map("music_enabled")
  musicUrl        String?   @map("music_url")
  musicTitle      String?   @default("Royal Shehnai & Sitar Harmony") @map("music_title")
  weddingDate     DateTime? @map("wedding_date")
  startTime       String?   @map("start_time")
  endTime         String?   @map("end_time")
  timeZone        String?   @default("Asia/Kolkata") @map("time_zone")
  userId          String?   @map("user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  template Template? @relation(fields: [templateId], references: [id])
  couple   Couple?
  events   Event[]
  venue    Venue?
  gallery  Gallery[]
  rsvps    Rsvp[]
  settings Setting[]

  @@map("invitations")
}

model Couple {
  id            String  @id @default(uuid())
  invitationId  String  @unique @map("invitation_id")
  groomName     String  @map("groom_name")
  brideName     String  @map("bride_name")
  groomPhoto    String? @map("groom_photo")
  bridePhoto    String? @map("bride_photo")
  couplePhoto   String? @map("couple_photo")
  introduction  String?
  story         String?
  familyMessage String? @map("family_message")
  familyNames   String? @map("family_names")

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@map("couples")
}

model Event {
  id           String   @id @default(uuid())
  invitationId String   @map("invitation_id")
  name         String
  date         DateTime
  startTime    String   @map("start_time")
  endTime      String?  @map("end_time")
  venueName    String   @map("venue_name")
  address      String
  description  String?
  icon         String?  @default("Sparkles")
  imageUrl     String?  @map("image_url")
  sortOrder    Int      @default(0) @map("sort_order")

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@map("events")
}

model Venue {
  id            String  @id @default(uuid())
  invitationId  String  @unique @map("invitation_id")
  venueName     String  @map("venue_name")
  fullAddress   String  @map("full_address")
  city          String
  state         String
  country       String  @default("India")
  latitude      Float?
  longitude     Float?
  googleMapsUrl String  @map("google_maps_url")

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@map("venues")
}

model Gallery {
  id           String   @id @default(uuid())
  invitationId String   @map("invitation_id")
  imageUrl     String   @map("image_url")
  caption      String?
  sortOrder    Int      @default(0) @map("sort_order")
  isCover      Boolean  @default(false) @map("is_cover")
  createdAt    DateTime @default(now()) @map("created_at")

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@map("gallery")
}

model Template {
  id            String       @id
  name          String
  description   String
  previewImage  String       @map("preview_image")
  category      String       @default("traditional")
  configuration String
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  invitations   Invitation[]

  @@map("templates")
}

model Rsvp {
  id             String   @id @default(uuid())
  invitationId   String   @map("invitation_id")
  guestName      String   @map("guest_name")
  phone          String
  email          String?
  guestsCount    Int      @default(1) @map("guests_count")
  attending      Boolean  @default(true)
  foodPreference String   @default("veg") @map("food_preference")
  message        String?
  createdAt      DateTime @default(now()) @map("created_at")

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@map("rsvps")
}

model Setting {
  id           String @id @default(uuid())
  invitationId String @map("invitation_id")
  section      String
  key          String
  value        String

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@map("settings")
}
