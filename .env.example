# ===============================================
# WEDDING INVITATION MANAGEMENT PLATFORM CONFIG
# ===============================================

# PostgreSQL Database URL (Supabase, Neon, AWS RDS, or local PostgreSQL)
# For local PostgreSQL or Supabase/Neon:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wedding_platform?schema=public"

# Authentication Secret (Generate a strong random string in production)
JWT_SECRET="super-secret-wedding-platform-jwt-key-change-in-production-2026"

# Public App URL (used for sharing links and OpenGraph tags)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Initial Admin Credentials (used during database seed)
ADMIN_DEFAULT_EMAIL="admin@weddingplatform.com"
ADMIN_DEFAULT_PASSWORD="Admin@Wedding2026!"

# Storage provider (local, s3, cloudinary)
STORAGE_PROVIDER="local"
